#!/usr/bin/env bash
# Generated by OpenOrchestrate.
# Full checks before a push: the pre-commit checks plus the test suite.
# Scoped to the commits actually being pushed. git passes the remote name and
# URL as $1/$2 and the ref pairs on stdin, so resolve each pair here and hand
# the real range to verify.sh.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO='0000000000000000000000000000000000000000'
RANGES=()

# stdin is the ref list during a push; by hand it is a terminal or /dev/null.
if [ ! -t 0 ]; then
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    if [ -z "${local_sha:-}" ]; then
      continue
    fi
    if [ "$local_sha" = "$ZERO" ]; then
      continue # deleting a remote ref: nothing to check
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
      # New branch: everything since it diverged from upstream is being pushed.
      base="$(git merge-base "$local_sha" '@{u}' 2>/dev/null || true)"
      if [ -z "$base" ]; then
        base="$(git merge-base "$local_sha" 'origin/HEAD' 2>/dev/null || true)"
      fi
      if [ -z "$base" ]; then
        continue
      fi
    else
      base="$remote_sha"
    fi
    RANGES+=("$base" "$local_sha")
  done
fi

# No range (run by hand): verify.sh falls back to @{u}..HEAD.
if [ "${#RANGES[@]}" -eq 0 ]; then
  exec bash "$ROOT/scripts/verify.sh" pre-push
fi

i=0
while [ "$i" -lt "${#RANGES[@]}" ]; do
  bash "$ROOT/scripts/verify.sh" pre-push "${RANGES[$i]}" "${RANGES[$((i + 1))]}"
  i=$((i + 2))
done

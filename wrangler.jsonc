{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyne-worker",
  "account_id": "debc6545e63bea36be059cbc82d80ec8",
  "main": "src/entry.py",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    // Unified traces across service bindings / DO (CF May 2026)
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "TRADE_WORKER_NAME": "trade-worker",
    // SaaS console base URL for the future tenant verify / usage path
    // (Phase 2 thin slice: Bearer hx_live_… is passthrough only, no remote
    // fetch yet, so this var is currently informational).
    "CONSOLE_URL": "https://console.hoox.sh"
    // Future quota enforcement will add a TENANT_KEYS KV binding here for the
    // verify cache (key hash → plan/scopes/limits, 60s TTL). Do NOT add the
    // binding until the verify path lands — a missing KV id breaks deploy.
  },
  // Bar-close scheduler: every minute (UTC). Only re-runs when R2 has a newer bar.
  // Keep 1m data fresh via scripts/fetch_and_ingest.py (Binance blocks CF IPs).
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Production secrets (set via `wrangler secret put`):
  //   API_KEY — shared secret for HTTP auth (X-API-Key header)
  //   ALERT_WEBHOOK_URL — default HTTPS destination for alert()/alertcondition()
  //   INTERNAL_KEY_BINDING — must match trade-worker mesh key for /webhook forward
  // Optional vars:
  //   DEFAULT_EXCHANGE — default trade exchange id (default: binance)
  "services": [
    {
      "binding": "TRADE_SERVICE",
      "service": "trade-worker"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OHLCV_DATA",
      "bucket_name": "pyne-worker-ohlcv",
      "preview_bucket_name": "pyne-worker-ohlcv-dev"
    }
  ]
}
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyne-worker",
  "account_id": "debc6545e63bea36be059cbc82d80ec8",
  "main": "src/entry.py",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    // Unified traces across service bindings / DO (CF May 2026)
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "TRADE_WORKER_NAME": "trade-worker",
    // SaaS console base URL for live tenant verify + usage metering.
    // Tenant `hx_live_…` keys are verified via
    //   GET {CONSOLE_URL}/api/v1/verify?scope=pyne:run
    // (hash-on-wire: Authorization carries sha256hex(raw), never the raw
    // key; results cached 60s positive / 10s negative in-isolate), and
    // `/run` + `/ingest` usage is flushed to POST {CONSOLE_URL}/api/v1/usage.
    // Unset/empty (self-host) keeps the legacy passthrough: tenant keys are
    // accepted without remote verify and no usage is reported.
    "CONSOLE_URL": "https://console.hoox.sh",
    // Guest POST /run + /ast/* (no X-API-Key) from product Origins:
    // *.hoox.sh, *.pynescript.online, *.axis.pages.dev,
    // *.pynescript-axis.pages.dev, and localhost. Management routes
    // still require API_KEY. Set to "0" to disable.
    "ALLOW_GUEST_RUN": "1"
    // Metering auth (optional — set via `wrangler secret put USAGE_SERVICE_KEY`):
    // Bearer for POST {CONSOLE_URL}/api/v1/usage. When unset, usage flush
    // falls back to the per-request tenant key hash (still hash-on-wire).
    // Future quota enforcement may add a TENANT_KEYS KV binding here for the
    // verify cache (key hash → plan/scopes/limits, 60s TTL). Do NOT add the
    // binding until needed — a missing KV id breaks deploy. Shape when added:
    //   "kv_namespaces": [{ "binding": "TENANT_KEYS", "id": "<kv-id>" }]
  },
  // Bar-close scheduler: every minute (UTC). Only re-runs when R2 has a newer bar.
  // Keep 1m data fresh via scripts/fetch_and_ingest.py (Binance blocks CF IPs).
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Production secrets (set via `wrangler secret put`):
  //   API_KEY — shared secret for HTTP auth (X-API-Key header)
  //   ALERT_WEBHOOK_URL — default HTTPS destination for alert()/alertcondition()
  //   INTERNAL_KEY_BINDING — must match trade-worker mesh key for /webhook forward
  //   USAGE_SERVICE_KEY — service Bearer for POST {CONSOLE_URL}/api/v1/usage
  //     (optional; falls back to the per-request tenant key hash)
  // Optional vars:
  //   DEFAULT_EXCHANGE — default trade exchange id (default: binance)
  //   ALLOWED_ORIGIN — extra CORS origins, comma-separated. Product hosts
  //     (*.hoox.sh, *.pynescript.online, *.axis.pages.dev,
  //     *.pynescript-axis.pages.dev) and localhost are always echoed;
  //     GET /health reflects any http(s) Origin.
  //   ALLOW_GUEST_RUN — "1" / "true" / "product" lets those Origins POST
  //     /run and /ast/* without X-API-Key. Management routes still need
  //     the key. Default unset/off in code; this deploy sets "1".
  //   PYNE_STRATEGY_RISK_CONTRACTS=1 — `strategy.risk.max_position_size` as
  //     absolute contracts (reference Pine). Default is %-of-equity.
  "services": [
    {
      "binding": "TRADE_SERVICE",
      "service": "trade-worker"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OHLCV_DATA",
      "bucket_name": "pyne-worker-ohlcv",
      "preview_bucket_name": "pyne-worker-ohlcv-dev"
    }
  ]
}